#!/usr/bin/env sh

labels() {
  printf '%s\n' \
    "Restart Noctalia" \
    "Screen Recorder"
}

run() {
  case "$1" in
    "Restart Noctalia") noctalia-shell kill; sleep 1 && noctalia-shell & ;;
    "Screen Recorder") ~/.config/niri/my-recorder commands ;;
  esac
}

selection="$(labels | tofi --prompt-text 'run: ')"
[ -n "$selection" ] && run "$selection"
