{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*auth.json": "deny",
      "*auth.jsonc": "deny",
      "*oauth_creds.json": "deny",
      "*credentials.json": "deny",
      "*.aws/credentials": "deny",
      "*.netrc": "deny",
      "~/.ssh/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*id_ecdsa": "deny",
      "secrets/*": "deny",
      "*/secrets/*": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf /": "deny",
      "mkfs*": "deny",
      "dd *of=/dev/*": "deny",
      ":(){*": "deny"
    },
    "external_directory": "allow"
  }
}
