#!/usr/bin/env bash
# harness-memory-links — resolve the [[wikilink]] graph across skill memories.
# Memories are the harness's durable knowledge; links let one memory point at
# another without duplicating it. This tool turns a [[name]] into a real path,
# shows what links back, and flags links whose target no longer exists (the
# failure mode when a memory is renamed).
#
# Usage:
#   harness-memory-links                    graph summary + every broken link
#   harness-memory-links --of <ref>         one memory: links out, links in, broken
#   harness-memory-links --all              every edge in the graph
#   harness-memory-links --check            broken links only; exit 1 if any (hooks/CI)
#
#   <ref> is "<skill>/<memory>" or just "<memory>" when unambiguous, with or
#   without the .md suffix.
#
# Resolution order for [[name]], matching harness-skill-pick's precedence:
#   1. the owning skill's own memory/
#   2. sibling skills in the same project
#   3. global skills under ~/.agents/skills
# Ambiguity is reported, never silently resolved.
#
# Read-only. No deps beyond awk. Convention: ~/.agents/docs/ + harness-ops skill.
set -uo pipefail

MODE=summary
REF=""

usage() {
  cat <<'EOF'
harness-memory-links — resolve the [[wikilink]] graph across skill memories

flags[4]{flag,arg,what}:
  --of,<ref>,one memory's outgoing links, backlinks and broken links
  --all,,every edge in the graph
  --check,,broken links only; exit 1 if any
  --help,,this text

ref: "<skill>/<memory>" or "<memory>" (.md optional)
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --of) MODE=detail; REF="${2:-}"; shift 2 || true
          [ -n "$REF" ] || { echo "error: --of requires a <ref>"; echo "help: harness-memory-links --of <skill>/<memory>"; exit 2; } ;;
    --all) MODE=all; shift ;;
    --check) MODE=check; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "error: unknown flag $1 for \`harness-memory-links\`"; echo "help: valid flags: --of <ref>, --all, --check, --help"; exit 2 ;;
  esac
done

# Memory roots, project before global (project wins on a name clash).
ROOTS=()
REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$REPO" ] && [ -d "$REPO/.agents/skills" ] && ROOTS+=("project:$REPO/.agents/skills")
[ -z "$REPO" ] && [ -d "$PWD/.agents/skills" ] && ROOTS+=("project:$PWD/.agents/skills")
[ -d "$HOME/.agents/skills" ] && ROOTS+=("global:$HOME/.agents/skills")

if [ ${#ROOTS[@]} -eq 0 ]; then
  echo "memories: 0 found (no .agents/skills in this project or ~/.agents/skills)"
  echo "help: memories live at <skill>/memory/<name>.md beside a SKILL.md"
  exit 0
fi

# "scope<TAB>skill<TAB>name<TAB>path" for every memory file found.
collect() {
  local scope="${1%%:*}" root="${1#*:}"
  [ -d "$root" ] || return 0
  find "$root" -mindepth 3 -maxdepth 3 -path '*/memory/*.md' 2>/dev/null | while read -r f; do
    local rel="${f#"$root"/}"
    local skill="${rel%%/*}"
    local base; base="$(basename "$f" .md)"
    printf '%s\t%s\t%s\t%s\n' "$scope" "$skill" "$base" "$f"
  done
}

TMP="$(mktemp 2>/dev/null || echo /tmp/hml.$$)"
trap 'rm -f "$TMP"' EXIT
for r in "${ROOTS[@]}"; do collect "$r"; done > "$TMP"

if [ ! -s "$TMP" ]; then
  echo "memories: 0 found under: $(printf '%s ' "${ROOTS[@]#*:}")"
  echo "help: memories live at <skill>/memory/<name>.md beside a SKILL.md"
  exit 0
fi

awk -F'\t' -v mode="$MODE" -v ref="$REF" '
  function basename(p,   n) { n=p; sub(/.*\//,"",n); return n }

  # --- index every memory -------------------------------------------------
  {
    scope[NR]=$1; skill[NR]=$2; name[NR]=$3; path[NR]=$4; rows=NR
    key=$2 "/" $3
    if (!(key in byKey)) byKey[key]=NR
    byPath[$4]=NR
    # name -> space-separated row ids, per scope, for fallback resolution
    ns=$1 SUBSEP $3
    byName[ns] = (ns in byName) ? byName[ns] " " NR : NR
  }

  END{
    # --- extract links ---------------------------------------------------
    nedge=0; nbroken=0
    for (i=1; i<=rows; i++) {
      while ((getline line < path[i]) > 0) {
        rest=line
        while (match(rest, /\[\[[^]]+\]\]/)) {
          tok=substr(rest, RSTART+2, RLENGTH-4)
          rest=substr(rest, RSTART+RLENGTH)
          sub(/\|.*$/,"",tok); sub(/\.md$/,"",tok)      # [[name|alias]], [[name.md]]
          sub(/^[ \t]+/,"",tok); sub(/[ \t]+$/,"",tok)
          if (tok=="") continue
          # skip the placeholder used in prose/examples
          if (tok ~ /^</ || tok ~ /^name$/) continue
          t=resolve(i, tok)
          nedge++
          esrc[nedge]=i; etok[nedge]=tok; edst[nedge]=t
          if (t==0) { nbroken++; brokenSrc[nbroken]=i; brokenTok[nbroken]=tok }
          else { backl[t] = (t in backl) ? backl[t] " " nedge : nedge }
        }
      }
      close(path[i])
    }

    if (mode=="check")   { emitBroken(); exit (nbroken>0 ? 1 : 0) }
    if (mode=="all")     { emitAll();    exit 0 }
    if (mode=="detail")  { emitDetail(); exit 0 }
    emitSummary()
  }

  # Resolve [[tok]] seen in memory row i. Returns a row id, 0 if broken,
  # -1 if ambiguous (recorded in AMBIG).
  function resolve(i, tok,   k, cand, n, arr, j, hits) {
    # 0. path-style link ([[../../other-skill/memory/name]]) — resolve against
    #    the linking file, then normalise away . and .. segments.
    if (tok ~ /\//) {
      dir=path[i]; sub(/\/[^\/]+$/,"",dir)
      cand=normalise(dir "/" tok ".md")
      return (cand in byPath) ? byPath[cand] : 0
    }
    k = skill[i] "/" tok                       # 1. same skill
    if (k in byKey) return byKey[k]
    # 2. same scope (project siblings), 3. then the other scope (global)
    for (j=0; j<2; j++) {
      sc = (j==0) ? scope[i] : ((scope[i]=="project") ? "global" : "project")
      cand = byName[sc SUBSEP tok]
      if (cand=="") continue
      n=split(cand, arr, " ")
      if (n==1) return arr[1]
      AMBIG = cand
      return -1
    }
    return 0
  }

  function label(i) { return skill[i] "/" name[i] }

  # Collapse "a/b/../c" -> "a/c" and "a/./b" -> "a/b" so path-style links
  # compare equal to the paths in the index.
  function normalise(p,   n, parts, out, k, i2) {
    n=split(p, parts, "/"); k=0
    for (i2=1; i2<=n; i2++) {
      if (parts[i2]=="" && i2>1) continue
      if (parts[i2]==".") continue
      if (parts[i2]=="..") { if (k>1) k--; continue }
      out[++k]=parts[i2]
    }
    p=out[1]; for (i2=2; i2<=k; i2++) p=p "/" out[i2]
    return p
  }

  function emitSummary(   i, resolved) {
    resolved = nedge - nbroken
    print "roots[" nroots() "]{scope,path}:"
    for (i=1; i<=rows; i++) if (!(scope[i] in seenScope)) {
      seenScope[scope[i]]=1
      p=path[i]; sub(/\/[^\/]+\/memory\/[^\/]+$/,"",p)
      print "  " scope[i] "," p
    }
    print "memories: " rows
    print "links: " nedge " (" resolved " resolved, " nbroken " broken)"
    if (nbroken==0) { print "broken: 0 broken links" }
    else emitBroken(1)
    print "help[1]: harness-memory-links --of <skill>/<memory> for one memory"
  }

  function nroots(   i, c) { c=0; for (i=1;i<=rows;i++) if (!(scope[i] in cnt)) { cnt[scope[i]]=1; c++ } return c }

  function emitBroken(quiet,   b) {
    if (nbroken==0) { print "broken: 0 broken links"; return }
    print "broken[" nbroken "]{source,target}:"
    for (b=1; b<=nbroken; b++) print "  " label(brokenSrc[b]) ",[[" brokenTok[b] "]]"
    if (!quiet) print "help[1]: rename the target, fix the link, or drop it"
  }

  function emitAll(   e) {
    print "links[" nedge "]{source,target,path}:"
    for (e=1; e<=nedge; e++)
      print "  " label(esrc[e]) ",[[" etok[e] "]]," (edst[e]>0 ? path[edst[e]] : "BROKEN")
  }

  function emitDetail(   i, hit, nhit, e, n, arr, j, outn, inn) {
    r=ref; sub(/\.md$/,"",r)
    nhit=0
    for (i=1; i<=rows; i++) {
      if (label(i)==r || name[i]==r) { hit=i; nhit++; hits[nhit]=i }
    }
    if (nhit==0) {
      print "error: no memory matching \"" ref "\""
      print "help: harness-memory-links --all to list every memory and edge"
      exit 2
    }
    if (nhit>1) {
      print "error: \"" ref "\" matches " nhit " memories"
      print "matches[" nhit "]{ref,path}:"
      for (j=1;j<=nhit;j++) print "  " label(hits[j]) "," path[hits[j]]
      print "help: qualify it as <skill>/<memory>"
      exit 2
    }
    print "memory: " label(hit)
    print "path: " path[hit]
    # Deduplicate by destination: three spellings of the same target are one
    # thing to read next, not three rows.
    outn=0; split("", seenDst)
    for (e=1;e<=nedge;e++) if (esrc[e]==hit && edst[e]>0 && !(edst[e] in seenDst)) {
      seenDst[edst[e]]=1; outT[++outn]=etok[e]; outP[outn]=path[edst[e]]
    }
    if (outn==0) print "links: 0 outgoing links"
    else {
      print "links[" outn "]{target,path}:"
      for (j=1;j<=outn;j++) print "  [[" outT[j] "]]," outP[j]
    }
    inn=0; split("", seenSrc)
    if (hit in backl) {
      n=split(backl[hit], arr, " ")
      for (j=1;j<=n;j++) if (!(esrc[arr[j]] in seenSrc)) {
        seenSrc[esrc[arr[j]]]=1; inS[++inn]=esrc[arr[j]]
      }
    }
    if (inn==0) print "backlinks: 0 memories link here"
    else {
      print "backlinks[" inn "]{source,path}:"
      for (j=1;j<=inn;j++) print "  " label(inS[j]) "," path[inS[j]]
    }
    bn=0; split("", seenBrk)
    for (e=1;e<=nedge;e++) if (esrc[e]==hit && edst[e]==0 && !(etok[e] in seenBrk)) {
      seenBrk[etok[e]]=1; brk[++bn]=etok[e]
    }
    if (bn==0) print "broken: 0 broken links"
    else {
      print "broken[" bn "]{target}:"
      for (j=1;j<=bn;j++) print "  [[" brk[j] "]]"
    }
  }
' "$TMP"
