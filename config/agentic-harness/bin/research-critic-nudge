#!/usr/bin/env bash
# UserPromptSubmit hook (thesis repo only): keeps the adversarial ICLR-spotlight
# reviewer in play WITHOUT Lokesh having to ask for it (standing request,
# 2026-07-22). Emits a one-line reminder when the prompt looks like a research
# decision; silent otherwise so it never taxes mechanical turns.
#
# Contract: stdin = JSON event payload; stdout = context injected for the model.
# Must stay <1s on the no-op path.
set -uo pipefail

payload="$(cat 2>/dev/null || true)"

# Only for the thesis repo.
case "${PWD:-}" in
  *Research/LiteratureSurvey*) ;;
  *) exit 0 ;;
esac

# Cheap keyword screen over the prompt text (no jq dependency).
prompt="$(printf '%s' "$payload" | tr '[:upper:]' '[:lower:]')"
case "$prompt" in
  *experiment*|*baseline*|*benchmark*|*ablation*|*claim*|*result*|*metric*|\
  *scenario*|*seed*|*paper*|*iclr*|*spotlight*|*present*|*report*|*novel*|\
  *contribution*|*evaluat*|*sufficient*|*enough*|*conclude*|*shows*|*proves*|\
  *significan*|*compare*|*sota*|*state-of-the-art*|*reviewer*)
    cat <<'EOF'
[research-gate] This turn touches a research decision. Per Lokesh's standing
requests, run the chain BEFORE acting on or reporting it:
  1. `research-theorist` — what existing theory predicts this outcome, or the
     NOVEL falsifiable hypothesis the experiment will prove/disprove (novelty
     checked against litgraph + the hypothesis ledger). No hypothesis => not a
     severe test => send the design back.
  2. `research-critic` — adversarial ICLR-spotlight review as a subagent; for an
     experiment plan this is a HARD GATE (no compute until cleared as a severe
     test whose failure is as informative as its success).
Report the hypothesis, the top objections, and their cost to fix. Do not
suppress an inconvenient critique.
EOF
    ;;
esac
exit 0
