#!/usr/bin/env bash
set -Eeuo pipefail

log()  { printf "\033[1;32m[ok]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[warn]\033[0m %s\n" "$*" >&2; }
err()  { printf "\033[1;31m[err]\033[0m %s\n" "$*" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

append_or_replace_block() {
  local file="$1"
  local start="$2"
  local end="$3"
  local body="$4"

  mkdir -p "$(dirname "$file")"
  touch "$file"

  if grep -Fq "$start" "$file"; then
    awk -v s="$start" -v e="$end" '
      BEGIN { skip = 0 }
      index($0, s) { skip = 1; next }
      index($0, e) { skip = 0; next }
      !skip { print }
    ' "$file" > "${file}.tmp"
    mv "${file}.tmp" "$file"
  fi

  {
    printf "\n%s\n" "$start"
    printf "%s\n" "$body"
    printf "%s\n" "$end"
  } >> "$file"
}

ensure_toml_array_value() {
  local file="$1"
  local key="$2"
  local value="$3"

  mkdir -p "$(dirname "$file")"
  touch "$file"

  awk -v key="$key" -v value="$value" '
    BEGIN { done = 0 }
    {
      if (!done && $0 ~ "^[[:space:]]*" key "[[:space:]]*=") {
        if (index($0, value) > 0) {
          print
        } else if ($0 ~ /\][[:space:]]*$/) {
          sub(/\][[:space:]]*$/, ", \"" value "\"]")
          print
        } else {
          print
          print key " = [\"" value "\"]"
        }
        done = 1
        next
      }
      print
    }
    END {
      if (!done) {
        print key " = [\"" value "\"]"
      }
    }
  ' "$file" > "${file}.tmp"

  mv "${file}.tmp" "$file"
}

clone_or_pull() {
  local repo_url="$1"
  local repo_dir="$2"

  if ! have git; then
    warn "git not found; skipping $repo_url"
    return 1
  fi

  if [ -d "$repo_dir/.git" ]; then
    log "Updating $(basename "$repo_dir")"
    git -C "$repo_dir" pull --ff-only
  else
    log "Cloning $(basename "$repo_dir")"
    mkdir -p "$(dirname "$repo_dir")"
    git clone "$repo_url" "$repo_dir"
  fi
}

backup_if_real_path() {
  local path="$1"
  if [ -e "$path" ] && [ ! -L "$path" ]; then
    local backup="${path}.backup.$(date +%s)"
    mv "$path" "$backup"
    warn "Backed up existing path to $backup"
  fi
}

install_or_update_antigravity_shared() {
  mkdir -p "$HOME/.agents/skills"

  if have npx; then
    log "Refreshing Antigravity Awesome Skills into $HOME/.agents/skills"
    npx -y antigravity-awesome-skills --path "$HOME/.agents/skills"
  else
    warn "npx not found; skipping Antigravity Awesome Skills"
  fi
}

install_or_update_superpowers_codex() {
  local repo_dir="$HOME/.codex/superpowers"
  local link_path="$HOME/.agents/skills/superpowers"

  clone_or_pull "https://github.com/obra/superpowers.git" "$repo_dir" || return 0

  mkdir -p "$HOME/.agents/skills"
  backup_if_real_path "$link_path"
  rm -f "$link_path"
  ln -s "$repo_dir/skills" "$link_path"

  log "Superpowers linked for Codex at $link_path"
}

install_or_update_superpowers_gemini() {
  if ! have gemini; then
    warn "gemini not found; skipping Superpowers Gemini extension"
    return 0
  fi

  if [ -d "$HOME/.gemini/extensions/superpowers" ]; then
    log "Updating Superpowers Gemini extension"
    gemini extensions update superpowers || warn "Could not update Superpowers in Gemini CLI"
  else
    log "Installing Superpowers Gemini extension"
    gemini extensions install https://github.com/obra/superpowers --auto-update --consent \
      || warn "Could not install Superpowers in Gemini CLI"
  fi
}

install_or_update_superpowers_claude() {
  if ! have claude; then
    warn "claude not found; skipping Superpowers Claude plugin"
    return 0
  fi

  log "Updating or installing Superpowers Claude plugin"
  claude plugin update superpowers@claude-plugins-official --scope user \
    || claude plugin install superpowers@claude-plugins-official --scope user \
    || warn "Could not install/update Superpowers in Claude Code"
}

install_or_update_agency_agents() {
  local repo_dir="$HOME/.local/share/ai-skill-bundles/agency-agents"

  clone_or_pull "https://github.com/msitarzewski/agency-agents.git" "$repo_dir" || return 0

  if [ ! -f "$repo_dir/scripts/install.sh" ]; then
    warn "Agency Agents install script not found; skipping"
    return 0
  fi

  if [ -f "$repo_dir/scripts/convert.sh" ]; then
    log "Refreshing Agency Agents Gemini CLI generated files"
    (
      cd "$repo_dir"
      bash ./scripts/convert.sh --tool gemini-cli
    ) || warn "Agency Agents Gemini conversion did not complete cleanly"
  fi

  log "Refreshing Agency Agents for Claude Code"
  (
    cd "$repo_dir"
    bash ./scripts/install.sh --tool claude-code
  ) || warn "Agency Agents Claude install did not complete cleanly"

  log "Refreshing Agency Agents for Gemini CLI"
  (
    cd "$repo_dir"
    bash ./scripts/install.sh --tool gemini-cli
  ) || warn "Agency Agents Gemini install did not complete cleanly"

  log "Refreshing Agency Agents for Antigravity"
  (
    cd "$repo_dir"
    bash ./scripts/install.sh --tool antigravity
  ) || warn "Agency Agents Antigravity install did not complete cleanly"
}

configure_codex_global_agents() {
  append_or_replace_block \
    "$HOME/.codex/AGENTS.md" \
    "<!-- AUTO_SKILL_PREFERENCES_START -->" \
    "<!-- AUTO_SKILL_PREFERENCES_END -->" \
"Prefer matching skills from ~/.agents/skills automatically when the task fits the skill description.

Bias toward skills for:
- HTML, CSS, frontend UI work, and UI/UX
- Flask and app development
- GCP and Kubernetes
- Security review and hardening
- Automation
- Code review and verification

For non-trivial coding tasks:
- plan briefly before editing
- keep diffs minimal
- run tests, lint, build, or validation when available
- summarize what was verified"
}

configure_gemini_global_memory() {
  append_or_replace_block \
    "$HOME/.gemini/GEMINI.md" \
    "<!-- AUTO_SKILL_PREFERENCES_START -->" \
    "<!-- AUTO_SKILL_PREFERENCES_END -->" \
"Prefer matching skills from ~/.agents/skills, installed Gemini extensions, and Antigravity skills when the task matches their descriptions.

Bias toward skills for:
- HTML, CSS, frontend UI work, and UI/UX
- Flask and app development
- GCP and Kubernetes
- Security review and hardening
- Automation
- Code review and verification

When Superpowers is relevant, use it for planning, debugging, TDD, review, and verification.
When Agency Agents are relevant, prefer the most specific specialist.

For non-trivial coding tasks:
- plan briefly before editing
- keep diffs minimal
- run tests, lint, build, or validation when available
- summarize what was verified"
}

configure_vibe_skill_paths() {
  local cfg="$HOME/.vibe/config.toml"
  ensure_toml_array_value "$cfg" "skill_paths" "$HOME/.agents/skills"
  log "Ensured Mistral Vibe can discover $HOME/.agents/skills"
}

main() {
  mkdir -p \
    "$HOME/.agents/skills" \
    "$HOME/.codex" \
    "$HOME/.gemini" \
    "$HOME/.vibe" \
    "$HOME/.local/share/ai-skill-bundles"

  install_or_update_antigravity_shared
  install_or_update_superpowers_codex
  install_or_update_superpowers_gemini
  install_or_update_superpowers_claude
  install_or_update_agency_agents
  configure_codex_global_agents
  configure_gemini_global_memory
  configure_vibe_skill_paths

  cat <<EOF

Done.

Installed / updated:
- Shared open skills:               $HOME/.agents/skills
- Superpowers repo for Codex:       $HOME/.codex/superpowers
- Superpowers symlink for Codex:    $HOME/.agents/skills/superpowers
- Agency Agents repo:               $HOME/.local/share/ai-skill-bundles/agency-agents
- Codex global guidance:            $HOME/.codex/AGENTS.md
- Gemini global guidance:           $HOME/.gemini/GEMINI.md
- Vibe config:                      $HOME/.vibe/config.toml

Useful checks:
- ls "$HOME/.agents/skills" | head
- ls -la "$HOME/.agents/skills/superpowers"
- test -d "$HOME/.claude/agents" && ls "$HOME/.claude/agents" | head || true
- test -d "$HOME/.gemini/extensions" && ls "$HOME/.gemini/extensions" | head || true
- test -d "$HOME/.gemini/antigravity/skills" && ls "$HOME/.gemini/antigravity/skills" | head || true
- grep -n "AUTO_SKILL_PREFERENCES" "$HOME/.codex/AGENTS.md" "$HOME/.gemini/GEMINI.md" 2>/dev/null || true
- grep -n "skill_paths" "$HOME/.vibe/config.toml" 2>/dev/null || true
EOF
}

main "$@"
