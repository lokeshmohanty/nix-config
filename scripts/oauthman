#!/usr/bin/env python3

import argparse
import base64
import hashlib
import json
import os
import secrets
import socket
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path


DEFAULT_PORT_RANGE = range(49152, 49252)
EXPIRY_SKEW_SECONDS = 120


PROVIDERS = {
    "microsoft": {
        "authorize_url": "https://login.microsoftonline.com/{tenant}/oauth2/v2.0/authorize",
        "token_url": "https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token",
        "device_authorize_url": "https://login.microsoftonline.com/{tenant}/oauth2/v2.0/devicecode",
        "scopes": [
            "offline_access",
            "https://outlook.office.com/IMAP.AccessAsUser.All",
            "https://outlook.office.com/SMTP.Send",
        ],
    },
    "gmail": {
        "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
        "token_url": "https://oauth2.googleapis.com/token",
        "scopes": [
            "https://mail.google.com/",
        ],
    },
}


BUILTIN_CLIENTS = {
    "microsoft": {
        "thunderbird": {
            "client_id": "9e5f94bc-e8a4-4e73-b8be-63364c29d753",
            "redirect_uri": "https://localhost",
            "source": "Thunderbird built-in issuer config from omni.ja",
        },
    },
    "gmail": {
        "thunderbird": {
            "client_id": "406964657835-aq8lmia8j95dhl1a2bvharmfk3t1hgqj.apps.googleusercontent.com",
            "client_secret": "kSmqreRr0qwBWJgbf5Y-PjSU",
            "source": "Thunderbird built-in issuer config from omni.ja",
        },
    },
}


def xdg_state_home() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))


def xdg_config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def state_dir() -> Path:
    return xdg_state_home() / "oauthman"


def config_dir() -> Path:
    return xdg_config_home() / "oauthman"


def profile_paths(name: str) -> tuple[Path, Path]:
    return config_dir() / f"{name}.json", state_dir() / f"{name}.json"


def ensure_dirs() -> None:
    config_dir().mkdir(parents=True, exist_ok=True)
    state_dir().mkdir(parents=True, exist_ok=True)


def load_json(path: Path) -> dict:
    if not path.exists():
        raise SystemExit(f"missing file: {path}")
    with path.open() as handle:
        return json.load(handle)


def save_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    with tmp_path.open("w") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.chmod(tmp_path, 0o600)
    os.replace(tmp_path, path)
    os.chmod(path, 0o600)


def provider_defaults(provider_name: str, tenant: str | None) -> dict:
    provider = PROVIDERS[provider_name].copy()
    resolved_tenant = tenant or "common"
    provider["authorize_url"] = provider["authorize_url"].format(tenant=resolved_tenant)
    provider["token_url"] = provider["token_url"].format(tenant=resolved_tenant)
    if provider.get("device_authorize_url"):
        provider["device_authorize_url"] = provider["device_authorize_url"].format(
            tenant=resolved_tenant
        )
    provider["tenant"] = resolved_tenant
    return provider


def resolve_client(provider_name: str, client_name: str | None) -> dict:
    if client_name is None:
        client_name = "thunderbird"
    provider_clients = BUILTIN_CLIENTS.get(provider_name, {})
    client = provider_clients.get(client_name)
    if client is None:
        choices = ", ".join(sorted(provider_clients)) or "none"
        raise SystemExit(
            f"unknown client preset '{client_name}' for provider '{provider_name}'. "
            f"Available presets: {choices}"
        )
    return client.copy()


def now() -> int:
    return int(time.time())


def choose_port() -> int:
    for port in DEFAULT_PORT_RANGE:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            if sock.connect_ex(("127.0.0.1", port)) != 0:
                return port
    raise SystemExit("could not find a free localhost port for OAuth callback")


def pkce_pair() -> tuple[str, str]:
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).decode().rstrip("=")
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode()).digest()
    ).decode().rstrip("=")
    return verifier, challenge


def post_form(url: str, payload: dict) -> dict:
    data = urllib.parse.urlencode(payload).encode()
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        raise SystemExit(f"token request failed: {exc.code} {body}") from exc


def refresh_access_token(config: dict, token_state: dict) -> dict:
    refresh_token = token_state.get("refresh_token")
    if not refresh_token:
        raise SystemExit("missing refresh token, re-run authorize")

    payload = {
        "grant_type": "refresh_token",
        "client_id": config["client_id"],
        "refresh_token": refresh_token,
        "scope": " ".join(config["scopes"]),
    }
    if config.get("client_secret"):
        payload["client_secret"] = config["client_secret"]

    response = post_form(config["token_url"], payload)
    updated = {
        "access_token": response["access_token"],
        "expires_at": now() + int(response.get("expires_in", 3600)),
        "refresh_token": response.get("refresh_token", refresh_token),
        "token_type": response.get("token_type", "Bearer"),
        "scope": response.get("scope"),
        "obtained_at": now(),
    }
    return updated


def ensure_access_token(profile: str) -> tuple[dict, dict]:
    config_path, token_path = profile_paths(profile)
    config = load_json(config_path)
    token_state = load_json(token_path)

    expires_at = int(token_state.get("expires_at", 0))
    if expires_at <= now() + EXPIRY_SKEW_SECONDS:
        token_state = refresh_access_token(config, token_state)
        save_json(token_path, token_state)

    return config, token_state


def cmd_init(args: argparse.Namespace) -> int:
    ensure_dirs()
    config_path, token_path = profile_paths(args.profile)
    if config_path.exists() and not args.force:
        raise SystemExit(f"profile already exists: {config_path}")

    provider = provider_defaults(args.provider, args.tenant)
    builtin = {}
    if args.client:
        builtin = resolve_client(args.provider, args.client)
    elif not args.client_id:
        builtin = resolve_client(args.provider, "thunderbird")

    client_id = args.client_id or builtin.get("client_id")
    client_secret = args.client_secret
    if client_secret is None and builtin.get("client_secret"):
        client_secret = builtin["client_secret"]
    redirect_uri = builtin.get("redirect_uri")

    if not client_id:
        raise SystemExit("missing client ID; pass --client-id or use --client thunderbird")

    scopes = args.scope or provider["scopes"]
    if redirect_uri is None:
        redirect_port = args.redirect_port or choose_port()
        redirect_uri = f"http://127.0.0.1:{redirect_port}/callback"

    config = {
        "profile": args.profile,
        "provider": args.provider,
        "email": args.email,
        "client_id": client_id,
        "client_secret": client_secret,
        "client_preset": args.client or ("thunderbird" if builtin else None),
        "client_source": builtin.get("source"),
        "tenant": provider["tenant"],
        "authorize_url": provider["authorize_url"],
        "token_url": provider["token_url"],
        "device_authorize_url": provider.get("device_authorize_url"),
        "scopes": scopes,
        "redirect_uri": redirect_uri,
    }
    save_json(config_path, config)
    if args.force and token_path.exists():
        token_path.unlink()

    print(config_path)
    return 0


def cmd_setup(args: argparse.Namespace) -> int:
    init_args = argparse.Namespace(
        profile=args.profile,
        provider=args.provider,
        email=args.email,
        client=args.client,
        client_id=args.client_id,
        client_secret=args.client_secret,
        tenant=args.tenant,
        scope=args.scope,
        redirect_port=args.redirect_port,
        force=args.force,
    )
    cmd_init(init_args)
    auth_args = argparse.Namespace(
        profile=args.profile,
        timeout=args.timeout,
        no_open=args.no_open,
        flow=args.flow,
    )
    return cmd_authorize(auth_args)


class OAuthCallbackHandler(BaseHTTPRequestHandler):
    server_version = "oauthman/1.0"

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != "/callback":
            self.send_error(404)
            return

        params = urllib.parse.parse_qs(parsed.query)
        self.server.oauth_result = {key: values[0] for key, values in params.items()}

        if "error" in self.server.oauth_result:
            body = f"OAuth failed: {self.server.oauth_result['error']}\n"
        else:
            body = "OAuth succeeded. You can close this window.\n"

        encoded = body.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def log_message(self, format: str, *args) -> None:
        return


def run_callback_server(port: int, timeout_seconds: int) -> dict:
    server = HTTPServer(("127.0.0.1", port), OAuthCallbackHandler)
    server.timeout = timeout_seconds
    server.oauth_result = None

    def serve() -> None:
        deadline = time.time() + timeout_seconds
        while server.oauth_result is None and time.time() < deadline:
            server.handle_request()

    thread = threading.Thread(target=serve, daemon=True)
    thread.start()
    thread.join(timeout_seconds + 1)

    if server.oauth_result is None:
        raise SystemExit("timed out waiting for OAuth callback")
    return server.oauth_result


def request_device_code(config: dict) -> dict:
    if not config.get("device_authorize_url"):
        raise SystemExit(f"device code flow is not supported for provider {config['provider']}")

    payload = {
        "client_id": config["client_id"],
        "scope": " ".join(config["scopes"]),
    }
    return post_form(config["device_authorize_url"], payload)


def exchange_device_code(config: dict, device_code: str) -> dict:
    payload = {
        "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
        "client_id": config["client_id"],
        "device_code": device_code,
    }
    if config.get("client_secret"):
        payload["client_secret"] = config["client_secret"]
    return post_form(config["token_url"], payload)


def authorize_with_device_code(config: dict, timeout_seconds: int) -> dict:
    device = request_device_code(config)
    message = device.get("message")
    if message:
        print(message, file=sys.stderr)
    else:
        print(
            f"Open {device['verification_uri']} and enter code {device['user_code']}",
            file=sys.stderr,
        )

    interval = int(device.get("interval", 5))
    deadline = time.time() + timeout_seconds

    while time.time() < deadline:
        time.sleep(interval)
        try:
            response = exchange_device_code(config, device["device_code"])
            return {
                "access_token": response["access_token"],
                "refresh_token": response.get("refresh_token"),
                "expires_at": now() + int(response.get("expires_in", 3600)),
                "token_type": response.get("token_type", "Bearer"),
                "scope": response.get("scope"),
                "obtained_at": now(),
            }
        except SystemExit as exc:
            text = str(exc)
            if "authorization_pending" in text:
                continue
            if "slow_down" in text:
                interval += 5
                continue
            if "expired_token" in text:
                raise SystemExit("device code expired before authorization completed") from exc
            raise

    raise SystemExit("timed out waiting for device code authorization")


def cmd_authorize(args: argparse.Namespace) -> int:
    ensure_dirs()
    config_path, token_path = profile_paths(args.profile)
    config = load_json(config_path)

    if args.flow == "device":
        token_state = authorize_with_device_code(config, args.timeout)
        save_json(token_path, token_state)
        print(token_path)
        return 0

    redirect_uri = config["redirect_uri"]
    parsed_redirect = urllib.parse.urlparse(redirect_uri)
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(24)

    query = {
        "client_id": config["client_id"],
        "response_type": "code",
        "redirect_uri": redirect_uri,
        "response_mode": "query",
        "scope": " ".join(config["scopes"]),
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
        "login_hint": config["email"],
    }

    auth_url = config["authorize_url"] + "?" + urllib.parse.urlencode(query)
    if args.no_open:
        print(auth_url, file=sys.stderr)
    else:
        webbrowser.open(auth_url)
        print("opened browser for OAuth flow", file=sys.stderr)

    result = run_callback_server(parsed_redirect.port, args.timeout)

    if result.get("state") != state:
        raise SystemExit("OAuth state mismatch")
    if "error" in result:
        details = result.get("error_description", result["error"])
        raise SystemExit(f"OAuth failed: {details}")

    payload = {
        "grant_type": "authorization_code",
        "client_id": config["client_id"],
        "code": result["code"],
        "redirect_uri": redirect_uri,
        "code_verifier": verifier,
    }
    if config.get("client_secret"):
        payload["client_secret"] = config["client_secret"]

    response = post_form(config["token_url"], payload)
    token_state = {
        "access_token": response["access_token"],
        "refresh_token": response.get("refresh_token"),
        "expires_at": now() + int(response.get("expires_in", 3600)),
        "token_type": response.get("token_type", "Bearer"),
        "scope": response.get("scope"),
        "obtained_at": now(),
    }
    save_json(token_path, token_state)
    print(token_path)
    return 0


def cmd_token(args: argparse.Namespace) -> int:
    _, token_state = ensure_access_token(args.profile)
    print(token_state["access_token"])
    return 0


def cmd_xoauth2(args: argparse.Namespace) -> int:
    config, token_state = ensure_access_token(args.profile)
    payload = f"user={config['email']}\x01auth=Bearer {token_state['access_token']}\x01\x01"
    print(base64.b64encode(payload.encode()).decode())
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    config_path, token_path = profile_paths(args.profile)
    config = load_json(config_path)
    token_state = load_json(token_path)
    expires_at = int(token_state.get("expires_at", 0))
    print(json.dumps(
        {
            "profile": args.profile,
            "provider": config["provider"],
            "email": config["email"],
            "client_preset": config.get("client_preset"),
            "client_source": config.get("client_source"),
            "expires_at": expires_at,
            "expires_in": max(0, expires_at - now()),
            "has_refresh_token": bool(token_state.get("refresh_token")),
            "scopes": config["scopes"],
        },
        indent=2,
        sort_keys=True,
    ))
    return 0


def cmd_client_id(args: argparse.Namespace) -> int:
    client = resolve_client(args.provider, args.client)
    client_id = client.get("client_id")
    if not client_id:
        raise SystemExit(
            f"client preset '{args.client or 'thunderbird'}' for provider '{args.provider}' has no client_id"
        )
    print(client_id)
    return 0


def cmd_client_secret(args: argparse.Namespace) -> int:
    client = resolve_client(args.provider, args.client)
    client_secret = client.get("client_secret")
    if not client_secret:
        raise SystemExit(
            f"client preset '{args.client or 'thunderbird'}' for provider '{args.provider}' has no client_secret"
        )
    print(client_secret)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="oauthman",
        description="OAuth helper for mbsync/msmtp with browser login, refresh, and XOAUTH2 output.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    setup_parser = subparsers.add_parser("setup", help="Create a profile and authorize it")
    setup_parser.add_argument("profile")
    setup_parser.add_argument("--provider", choices=sorted(PROVIDERS), default="microsoft")
    setup_parser.add_argument("--email", required=True)
    setup_parser.add_argument("--client")
    setup_parser.add_argument("--client-id")
    setup_parser.add_argument("--client-secret")
    setup_parser.add_argument("--tenant")
    setup_parser.add_argument("--scope", action="append")
    setup_parser.add_argument("--redirect-port", type=int)
    setup_parser.add_argument("--flow", choices=["authcode", "device"], default="device")
    setup_parser.add_argument("--timeout", type=int, default=300)
    setup_parser.add_argument("--no-open", action="store_true")
    setup_parser.add_argument("--force", action="store_true")
    setup_parser.set_defaults(func=cmd_setup)

    init_parser = subparsers.add_parser("init", help="Create or update a profile")
    init_parser.add_argument("profile")
    init_parser.add_argument("--provider", choices=sorted(PROVIDERS), default="microsoft")
    init_parser.add_argument("--email", required=True)
    init_parser.add_argument("--client", help="Built-in client preset, defaults to thunderbird")
    init_parser.add_argument("--client-id")
    init_parser.add_argument("--client-secret")
    init_parser.add_argument("--tenant")
    init_parser.add_argument("--scope", action="append")
    init_parser.add_argument("--redirect-port", type=int)
    init_parser.add_argument("--force", action="store_true")
    init_parser.set_defaults(func=cmd_init)

    authorize_parser = subparsers.add_parser("authorize", help="Run the browser OAuth flow")
    authorize_parser.add_argument("profile")
    authorize_parser.add_argument("--timeout", type=int, default=180)
    authorize_parser.add_argument("--no-open", action="store_true")
    authorize_parser.add_argument(
        "--flow",
        choices=["authcode", "device"],
        default="authcode",
        help="Use browser callback flow or OAuth device code flow",
    )
    authorize_parser.set_defaults(func=cmd_authorize)

    token_parser = subparsers.add_parser("token", help="Print a valid access token")
    token_parser.add_argument("profile")
    token_parser.set_defaults(func=cmd_token)

    xoauth2_parser = subparsers.add_parser("xoauth2", help="Print base64 XOAUTH2 payload")
    xoauth2_parser.add_argument("profile")
    xoauth2_parser.set_defaults(func=cmd_xoauth2)

    status_parser = subparsers.add_parser("status", help="Print profile/token status")
    status_parser.add_argument("profile")
    status_parser.set_defaults(func=cmd_status)

    client_id_parser = subparsers.add_parser(
        "client-id", help="Print a built-in OAuth client ID"
    )
    client_id_parser.add_argument(
        "--provider", choices=sorted(PROVIDERS), required=True
    )
    client_id_parser.add_argument(
        "--client", default="thunderbird", help="Built-in client preset"
    )
    client_id_parser.set_defaults(func=cmd_client_id)

    client_secret_parser = subparsers.add_parser(
        "client-secret", help="Print a built-in OAuth client secret"
    )
    client_secret_parser.add_argument(
        "--provider", choices=sorted(PROVIDERS), required=True
    )
    client_secret_parser.add_argument(
        "--client", default="thunderbird", help="Built-in client preset"
    )
    client_secret_parser.set_defaults(func=cmd_client_secret)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
